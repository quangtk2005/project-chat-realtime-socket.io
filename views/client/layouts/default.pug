    link(rel="icon", href="/client/assets/img/favicon.png")
    // Theme Script Js
    script(src="/client/assets/js/theme-script.js")
    // CryptoJS
    script(src="https://cdnjs.cloudflare.com/ajax/libs/crypto-js/4.0.0/crypto-js.min.js")
    // Emoji Picker Element
    script(src="https://cdn.jsdelivr.net/npm/emoji-mart@latest/dist/browser.js")
    // Bootstrap CSS
    link(rel="stylesheet", href="/client/assets/css/bootstrap.min.css")
    // Feathericon CSS
    link(rel="stylesheet", href="/client/assets/css/feather.css")
    // Fontawesome CSS
