                                        i(class="ti ti-pinned me-2")
                                        | Pin Chats
                                    li
                                      a(class="dropdown-item", href="index.html#", data-bs-toggle="modal", data-bs-target="#delete-chat")
                                        i(class="ti ti-trash me-2")
