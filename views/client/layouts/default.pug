                        div(class="chat-users-wrap")
                          - if(ROOM_FRIENDS && ROOM_FRIENDS.length > 0)
                            each friend in ROOM_FRIENDS
                              - const friendUser = friend.users.find(it => USER._id.toString() != it.user_id._id.toString())
                              - const friendAvatar = friendUser && friendUser.user_id.picture ? friendUser.user_id.picture : "/client/assets/img/profiles/avatar-01.jpg"
                              - const friendName = friendUser ? friendUser.user_id.name : ""
                              - const lastChat = friend.lastChat
                              - const lastMessage = lastChat ? (lastChat.content || (lastChat.images && lastChat.images.length > 0 ? "Đã gửi ảnh" : "")) : ""
                              - const lastMessageTime = lastChat ? moment(lastChat.createdAt).format("hh:mm A") : ""
                              div(class="chat-list" data-room-id=friend._id)
                                a(href=`/chat/${friend._id}`, class="chat-user-list")
                                  div(class="avatar avatar-lg online me-2")
                                    img(src=friendAvatar, class="rounded-circle border border-warning border-2", alt="image" onerror="this.src='/client/assets/img/profiles/avatar-01.jpg'")
                                  div(class="chat-user-info")
                                    div(class="chat-user-msg")
                                      h6 #{friendName}
                                      p(class="last-message")
                                        span(class="typing-indicator-text" style="display: none;")
                                          span(class="animate-typing")
                                            | is typing
                                            span(class="dot")
                                            span(class="dot")
                                            span(class="dot")
                                        span(class="message-text") #{lastMessage}
                                    div(class="chat-user-time")
                                      span(class="time") #{lastMessageTime}
                                      div(class="chat-pin")
                                        i(class="ti ti-pin me-2")
                                        span(class="count-message fs-12 fw-semibold") 0
                                div(class="chat-dropdown")
                                  a(class="#", href="index.html#", data-bs-toggle="dropdown")
                                    i(class="ti ti-dots-vertical")
                                  ul(class="dropdown-menu dropdown-menu-end p-3")
