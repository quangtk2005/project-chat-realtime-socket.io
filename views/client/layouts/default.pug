  body
    // Main Wrapper
    div(class="main-wrapper")
      // content
      div(class="content main_content")
        // Left Sidebar Menu
        div(class="sidebar-menu")
          div(class="logo")
            a(href="index.html", class="logo-normal")
              img(src="/client/assets/img/logo.svg", alt="Logo")
          div(class="menu-wrap")
            div(class="main-menu")
              ul(class="nav")
                li(data-bs-toggle="tooltip", data-bs-placement="right", data-bs-original-title="Tải lại trang", data-bs-custom-class="tooltip-primary")
                  a(href=null, class="", onclick="reloadPage()")
                    i(class="ti ti-refresh")
                li(data-bs-toggle="tooltip", data-bs-placement="right", data-bs-original-title="Chats", data-bs-custom-class="tooltip-primary")
                  a(href=`/`, class="", data-bs-toggle="tab", data-bs-target="#chat-menu")
                    i(class="ti ti-message-2-heart")
                li(data-bs-toggle="tooltip", data-bs-placement="right", data-bs-original-title="Người dùng", data-bs-custom-class="tooltip-primary")
                  a(href=`/account/not-friend`, class="")
                    i(class="ti ti-users")
                li(data-bs-toggle="tooltip", data-bs-placement="right", data-bs-original-title="Lời mời đã nhận", data-bs-custom-class="tooltip-primary" class="position-relative")
                  a(href=`/account/accept`, class="")
                    i(class="ti ti-user-plus")
                  div(class="badge bg-danger fs-10 rounded-circle position-absolute top-0 start-100 translate-middle" stock-invite-accept = `${USER._id}`) #{USER.accept_friends.length || 0}
                li(data-bs-toggle="tooltip", data-bs-placement="right", data-bs-original-title="Lời mời đã gửi đi", data-bs-custom-class="tooltip-primary" class="position-relative")
                  a(href=`/account/request`, class="")
                    i(class="ti ti-user-minus")
                  div(class="badge bg-danger fs-10 rounded-circle position-absolute top-0 start-100 translate-middle" stock-invite-request = `${USER._id}`) #{USER.request_friends.length || 0}
                li(data-bs-toggle="tooltip", data-bs-placement="right", data-bs-original-title="Nhóm chat", data-bs-custom-class="tooltip-primary")
                  a(href="index.html#", class="", data-bs-toggle="tab", data-bs-target="#group-menu")
                    i(class="ti ti-users-group")
                
            div(class="profile-menu")
              ul
                li
                  a#dark-mode-toggle(href="index.html#", class="dark-mode-toggle active")
                    i(class="ti ti-moon")
                  a#light-mode-toggle(href="index.html#", class="dark-mode-toggle")
                    i(class="ti ti-sun")
                li
                  div(class="dropdown")
                    a(href="index.html#", class="avatar avatar-md", data-bs-toggle="dropdown")
                      img(src="/client/assets/img/profiles/avatar-16.jpg", alt="img", class="rounded-circle")
                    div(class="dropdown-menu dropdown-menu-end p-3")
                      a(href="signin.html", class="dropdown-item")
                        i(class="ti ti-logout-2 me-2")
                        | Logout
        // /Left Sidebar Menu
        // sidebar group
        div(class="sidebar-group")
